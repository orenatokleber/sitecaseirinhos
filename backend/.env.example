# Porta do servidor backend Fastify
PORT=3001
HOST=0.0.0.0

# Conexão MySQL para Prisma ORM
# Hostinger/Produção: mysql://usuario:senha@host:3306/banco
DATABASE_URL="mysql://root:root@localhost:3306/caseirinhos"

# Chave secreta de assinatura JWT
JWT_SECRET="caseirinhos-super-secret-key-123456"

# URLs permitidas para requisições CORS (separadas por vírgula)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
