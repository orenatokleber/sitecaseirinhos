<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ignora arquivos e diretórios reais existentes (HTML, CSS, JS, Imagens, API, etc.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirecionamento Pretty Links direto na raiz: caseirinhos.com/slug -> r.php?slug=slug
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ r.php?slug=$1 [L,QSA]
</IfModule>
